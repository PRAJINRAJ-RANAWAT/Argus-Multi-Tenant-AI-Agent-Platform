#!/bin/sh
# Strip forbidden attribution trailers from commit messages.
# Removes any line matching Co-Authored-By, Generated with Claude, or Claude-Session (case-insensitive).
msg_file="$1"
[ -f "$msg_file" ] || exit 0
tmp="${msg_file}.tmp.$$"
grep -viE 'co-authored-by|generated with claude|claude-session' "$msg_file" > "$tmp" || true
# Trim trailing blank lines left behind by removed trailers.
awk 'NF { for (i = 0; i < blank; i++) print ""; blank = 0; print; next } { blank++ }' "$tmp" > "$msg_file"
rm -f "$tmp"
if ! grep -q '[^[:space:]]' "$msg_file"; then
  echo "commit-msg: message is empty after removing attribution lines" >&2
  exit 1
fi
exit 0
