# Copy to .env and fill in. Never commit .env.
ARGUS_ENV=dev
ARGUS_LOG_LEVEL=INFO

# Postgres (compose service "postgres")
POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=argus
ARGUS_DATABASE_URL=postgresql://argus:change-me@postgres:5432/argus

# Redis (compose service "redis")
ARGUS_REDIS_URL=redis://redis:6379/0

# Production only: public hostname served by Caddy (TLS via Let's Encrypt)
ARGUS_DOMAIN=argus.example.com

# GitHub App (see docs/github-app.md)
ARGUS_GITHUB_WEBHOOK_SECRET=replace-with-random-hex
ARGUS_GITHUB_APP_ID=123456
# PEM private key of the GitHub App. Either inline with \n escapes, or a path:
ARGUS_GITHUB_PRIVATE_KEY=
ARGUS_GITHUB_PRIVATE_KEY_PATH=

# LLM provider (any OpenAI-compatible endpoint). Dev/tests use the mock LLM.
ARGUS_LLM_BASE_URL=http://mock-llm:8000/v1
ARGUS_LLM_API_KEY=
ARGUS_LLM_MODEL=mock-large

# Admin API (/admin/dlq...) bearer token until M4 adds user auth. Empty disables it.
ARGUS_ADMIN_TOKEN=

# Embeddings (OpenAI-compatible). Empty base URL = ARGUS_LLM_BASE_URL.
ARGUS_EMBED_BASE_URL=
ARGUS_EMBED_API_KEY=
ARGUS_EMBED_MODEL=mock-embed

# GitHub OAuth login (the GitHub App's OAuth client id/secret) and public URL.
ARGUS_GITHUB_OAUTH_CLIENT_ID=
ARGUS_GITHUB_OAUTH_CLIENT_SECRET=
ARGUS_PUBLIC_URL=http://localhost:8000
# Set false only for local http development.
ARGUS_COOKIE_SECURE=true

# LLM gateway: tier -> model chain (provider:model, first is primary, rest are fallbacks).
ARGUS_LLM_ROUTES={"large": ["openai:mock-large", "openai:mock-small"], "small": ["openai:mock-small", "openai:mock-large"]}
ARGUS_ANTHROPIC_BASE_URL=
ARGUS_ANTHROPIC_API_KEY=
ARGUS_TENANT_TOKENS_PER_MIN=400000
ARGUS_PROVIDER_REQUESTS_PER_MIN=600

# Observability: OTLP/HTTP endpoint for traces (empty = off) and optional headers.
ARGUS_OTEL_ENDPOINT=
ARGUS_OTEL_HEADERS=
