# Copy to .env and fill in. Never commit .env.
ARGUS_ENV=dev
ARGUS_LOG_LEVEL=INFO

# Postgres (compose service "postgres")
POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=argus
ARGUS_DATABASE_URL=postgresql://argus:change-me@postgres:5432/argus

# Redis (compose service "redis")
ARGUS_REDIS_URL=redis://redis:6379/0

# Production only: public hostname served by Caddy (TLS via Let's Encrypt)
ARGUS_DOMAIN=argus.example.com
