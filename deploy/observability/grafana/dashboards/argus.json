{
  "uid": "argus-overview",
  "title": "Argus overview",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "argus"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Webhook ack latency p99 (SLO 300 ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(argus_http_request_duration_seconds_bucket{service=\"argus-ingest\",route=\"/webhooks/github\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Webhooks by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(argus_webhooks_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stream, state) (argus_queue_depth)",
          "legendFormat": "{{stream}} {{state}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Oldest unacked message age",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (stream) (argus_queue_oldest_pending_age_seconds)",
          "legendFormat": "{{stream}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Runs by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent, outcome) (rate(argus_runs_total[5m]))",
          "legendFormat": "{{agent}} {{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Review duration p95 (SLO 2 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(argus_run_duration_seconds_bucket{agent=\"pr_review\"}[15m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM tokens by model",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, kind) (rate(argus_llm_tokens_total[5m]))",
          "legendFormat": "{{model}} {{kind}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM cost per hour (USD)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(argus_llm_cost_usd_total[1h])) * 3600",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM calls by status and route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, status, route) (rate(argus_llm_calls_total[5m]))",
          "legendFormat": "{{model}} {{status}} {{route}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Circuit breaker state (2 = open)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (model) (argus_breaker_state)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Steps per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, result) (rate(argus_run_steps_total[5m]))",
          "legendFormat": "{{kind}} {{result}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "SLO burn rates",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "argus:webhook_slow_ratio:rate1h / 0.01",
          "legendFormat": "webhook latency (1h)"
        },
        {
          "refId": "B",
          "expr": "argus:http_error_ratio:rate1h / 0.005",
          "legendFormat": "availability (1h)"
        },
        {
          "refId": "C",
          "expr": "argus:review_slow_ratio:rate1h / 0.05",
          "legendFormat": "review latency (1h)"
        }
      ]
    }
  ]
}
